android_app {
    name: "MotoActions",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    
    platform_apis: true,
    certificate: "platform",
    privileged: true,

    static_libs: [
        "androidx.core_core",
        "android-support-v13",
        "androidx.preference_preference",
        "SettingsLib",
        "org.lineageos.settings.resources",
    ],

    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],

    optimize: {
        enabled: false,
        proguard_flags_files: ["proguard.flags"],
    },
    
    dex_preopt: {
        enabled: true,
    },
}
